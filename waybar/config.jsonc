{
  // ==========================================================
  // 1. BARRA PRINCIPAL
  // Posição, altura e distribuição dos módulos.
  // Barra plana e contínua no topo.
  // ==========================================================
  "layer": "top",
  "position": "top",
  "height": 28,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "mpris",
    "custom/screenrecording-indicator"
  ],
  "modules-right": [
    "group/tray-expander",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "custom/power"
  ],

  // ==========================================================
  // 2. ÁREAS DE TRABALHO (WORKSPACES)
  // O clique nativo do módulo troca de área de trabalho.
  // ==========================================================
  "hyprland/workspaces": {
    "format": "{id}",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5
    }
  },

  // ==========================================================
  // 3. JANELA ATIVA (HYPRLAND WINDOW)
  // ==========================================================
  "hyprland/window": {
    "format": "{}",
    "max-length": 35,
    "separate-outputs": true
  },

  // ==========================================================
  // 4. RELÓGIO E DATA (CLOCK)
  // ==========================================================
  "clock": {
    "format": "󰥔 {:%A %H:%M}",
    "format-alt": "󰸗 {:%d/%m/%Y}",
    "tooltip": false
  },

  // ==========================================================
  // 5. PLAYER DE MÍDIA (MPRIS)
  // ==========================================================
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "max-length": 28,
    "player-icons": {
      "default": "󰎆",
      "spotify": "󰓇"
    },
    "status-icons": {
      "paused": "󰏤"
    }
  },

  // ==========================================================
  // 6. INDICADOR DE GRAVAÇÃO DE TELA (OMARCHY STYLE)
  // ==========================================================
  "custom/screenrecording-indicator": {
    "exec": "if [ -f /tmp/omarchy_recording.pid ]; then echo '{\"text\":\" Gravando\",\"class\":\"active\",\"tooltip\":\"Clique para parar a gravação\"}'; else echo ''; fi",
    "return-type": "json",
    "signal": 8,
    "interval": 2,
    "on-click": "/home/jp/.config/hypr/scripts/screenshot.sh record-toggle"
  },

  // ==========================================================
  // 7. GAVETA RETRÁTIL DO TRAY (GROUP/TRAY-EXPANDER)
  // Esconde os ícones do tray atrás de um botão expansível.
  // ==========================================================
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "tray-child"
    },
    "modules": [
      "custom/tray-icon",
      "tray"
    ]
  },
  "custom/tray-icon": {
    "format": "󱊖",
    "tooltip": false
  },
  "tray": {
    "icon-size": 14,
    "spacing": 10
  },

  // ==========================================================
  // 8. BLUETOOTH
  // ==========================================================
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲 off",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} conectado(s)",
    "on-click": "kitty --class bluetui -e bluetui"
  },

  // ==========================================================
  // 9. REDE (NETWORK)
  // ==========================================================
  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀 cabo",
    "format-disconnected": "󰤭 off",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "on-click": "kitty --class impala -e impala"
  },

  // ==========================================================
  // 10. ÁUDIO (PULSEAUDIO)
  // ==========================================================
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mute",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  // ==========================================================
  // 11. PROCESSADOR (CPU)
  // ==========================================================
  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 3,
    "on-click": "kitty -e htop"
  },

  // ==========================================================
  // 12. MEMÓRIA RAM (MEMORY)
  // ==========================================================
  "memory": {
    "format": "󰘚 {percentage}%",
    "interval": 5,
    "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB",
    "on-click": "kitty -e htop"
  },

  // ==========================================================
  // 13. BATERIA
  // ==========================================================
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "states": {
      "warning": 25,
      "critical": 10
    }
  },

  // ==========================================================
  // 14. MENU DE ENERGIA / SAÍDA (CUSTOM/POWER)
  // ==========================================================
  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun"
  }
}